# FlyBot on AWS: every deploy setting in one file.
#
#   cp deploy.env.example deploy.env     (deploy.env is git-ignored: never commit it)
#   fill it once, then:  aws login --profile sentinel  &&  ./deploy.sh      (Windows: deploy.bat)
#
# Format: KEY=VALUE, one per line; the explanation is the comment above each key. Values are literal (no $ expansion).
# Quote a value that contains "#" or spaces: SMTP_PASS="ab #cd". An empty value means the default or "feature off".
# Keys marked (secret) go to AWS Secrets Manager (flybot-<STAGE>-app) and never to the server's disk; the scripts never
# print a secret value.


# ===================================================================== AWS

# Name of this deployment. The stack is flybot-<STAGE>; every resource name carries it.
STAGE=dev

# AWS CLI profile used for `aws login`.
AWS_PROFILE=sentinel

# Region. Fixed: the account allows Sydney only; any other value is refused.
AWS_REGION=ap-southeast-2


# ===================================================================== Web address and notifications

# The site's name. Caddy gets its TLS certificate; add the A record the script prints at your DNS provider.
DOMAIN_NAME=flybot.agrhub.com

# Contact for Let's Encrypt (certificate expiry notices). Empty: ALARM_EMAIL.
ACME_EMAIL=

# Email for CloudWatch alarms. Empty: reuse an SNS topic that already has a confirmed email.
# A new address receives a confirmation email from AWS that must be clicked once.
ALARM_EMAIL=

# Source address allowed on SSH, as x.x.x.x/32. Empty: this computer's public IP.
# SSH is optional: the scripts reach the server through AWS SSM, no key pair needed.
OWNER_CIDR=


# ===================================================================== FlyBot build and release

# Your FlyBot checkout (relative to this folder, or an absolute path). The script runs `npm ci` there (only when
# package-lock.json changed) and `npm run build`, packs the release and publishes it; the server downloads it, so it
# needs no GitHub access and builds nothing. Uncommitted changes are refused unless ./deploy.sh --allow-dirty.
FLYBOT_SRC=../ezviz-manager

# Where the release tarball is published: github (a pre-release of GITHUB_REPO, downloaded anonymously by the server)
# or s3 (the stack's private artifacts bucket). github needs GITHUB_TOKEN; without it the script uses s3 and says so.
FLYBOT_RELEASE_STORE=github

# The public GitHub repository that receives the deploy builds as pre-releases named "FlyBot <commit> (deploy build)".
GITHUB_REPO=agrhub/flybot-aws

# (secret, this computer only) Fine-grained GitHub token for GITHUB_REPO with "Contents: read and write".
# Used only by ./deploy.sh to create the release and upload the tarball; it is never stored in AWS or sent to the server.
GITHUB_TOKEN=

# How many deploy builds to keep on GitHub when ./deploy.sh --prune-releases runs (older ones and their tags are
# deleted; the release the server runs is always kept). Default 5.
FLYBOT_KEEP_RELEASES=

# separate (default): the home-page and manual videos (client/dist/media/*.mp4, ~190 MB) are left out of the release
# and published once to the artifacts bucket; the server keeps a local copy that Caddy serves. bundled: the videos stay
# inside every release tarball (~220 MB instead of ~17 MB).
FLYBOT_MEDIA=

# Google Maps browser key baked into the client at build time (public by nature; restrict it to your domain).
VITE_GOOGLE_MAP_KEY=


# ===================================================================== Database

# (secret) MongoDB connection string. Empty: MongoDB 7 runs on the server, its data on the server's disk.
# Set, e.g. mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/flybot: that database is used and no MongoDB is installed.
# MongoDB Atlas: allow the Elastic IP printed in the summary in the Atlas IP access list.
# Careful: if other FlyBot servers use the same database, this server's start-up migrations (e.g. workspaces-v1) run
# on that data too.
MONGO_URI=


# ===================================================================== Photo storage

# The photo bucket. Empty: the stack creates and owns flybot-photos-<account>-<STAGE>.
# An existing AWS bucket name: used as is (the server and the Lambda get access; the stack never creates or deletes it).
# With S3_ENDPOINT: the bucket on that service.
S3_BUCKET_NAME=

# The bucket's region. Empty: looked up for an AWS bucket, "auto" for other services.
S3_REGION=

# S3-compatible storage (MinIO, Cloudflare R2, ...): the URL of the service, https:// (recommended) or http://.
# Empty: AWS S3. With it, FlyBot gives the Lambda presigned URLs, so the service must be reachable from the internet
# (a private address is refused; plain http gets a warning). The Lambda stores no picture: FlyBot draws its boxes.
S3_ENDPOINT=

# (secret) Access key for S3_ENDPOINT. Empty with an AWS bucket: the server's role is used.
S3_ACCESS_KEY=

# (secret) Secret key for S3_ENDPOINT.
S3_SECRET_KEY=


# ===================================================================== Vision Lambda

# Detector: yolo26 (default; needs models/yolo26/fruitfly_yolo26n.onnx, uploaded by the script) or yolov7 (baseline).
# yolo26 without the local files falls back to yolov7 with a warning.
DETECTOR=yolo26

# Tiled detection for small flies (YOLO26): off (default) | sticky (2x2 windows on sticky-trap photos: on the
# synthetic ESP32 card recall 0.07 -> 0.82, 4 forwards per photo; eval/SYNTHETIC_RESULTS.md) | on | auto.
# sticky also changes the counts of EZVIZ cameras with sticky traps.
DETECTOR_TILES=off

# Planner for every photo: rule (deterministic, free; default) or llm (Anthropic per photo).
# Chatbot questions (deep mode) use the LLM whenever a key exists.
PLANNER_MODE=rule

# Secrets Manager secret that holds the Anthropic API key. Reused when it exists.
ANTHROPIC_SECRET_NAME=sentinel-dev-anthropic

# (secret) Anthropic API key, only when the secret above does not exist; stored as flybot-<STAGE>-anthropic.
ANTHROPIC_API_KEY=

# Anthropic model for the planner and deep-mode answers.
ANTHROPIC_MODEL=claude-haiku-5-5


# ===================================================================== FlyBot app

# (secret) Signs the login tokens. Empty: generated once and kept (changing it logs everybody out).
JWT_SECRET=

# (secret) EZVIZ Open Platform app key, for EZVIZ cameras. Empty: EZVIZ cameras cannot be added.
APP_KEY=

# (secret) EZVIZ Open Platform app secret.
SECRET_KEY=

# EZVIZ API domain. Empty: https://ivnopen.ezvizlife.com
EZVIZ_DOMAIN=

# (secret) Telegram bot token from @BotFather. Empty: Telegram alerts off.
TELEGRAM_BOT_TOKEN=

# The Telegram bot's username, without @.
TELEGRAM_BOT_USERNAME=

# Mail server for verification, password reset and alert emails. Empty: emails are written to the server log.
SMTP_HOST=

# Mail server port: 587 (STARTTLS) or 465 with SMTP_SECURE=true. Empty: 587.
SMTP_PORT=

# true for implicit TLS (port 465). Empty: false.
SMTP_SECURE=

# Mail login; also the sender when it is an email address.
SMTP_USER=

# (secret) Mail password.
SMTP_PASS=

# Sender, e.g. FlyBot <no-reply@agrhub.com>. Empty: SMTP_USER.
MAIL_FROM=

# Public contact address (legal pages, contact form). Empty: SMTP_USER.
CONTACT_EMAIL=

# Web push key pair. Both empty: a pair is generated once (openssl) and kept.
VAPID_PUBLIC_KEY=

# (secret) Web push private key.
VAPID_PRIVATE_KEY=

# Web push contact. Empty: mailto:<ACME_EMAIL>.
VAPID_SUBJECT=

# Business mode: b2c (personal workspaces), b2b (organizations, invite-only) or hybrid (both; default).
APP_MODE=hybrid


# ===================================================================== Chatbot (Gemini on Vertex AI)

# Path to the Google service-account JSON, kept outside git (e.g. C:/Users/me/keys/flybot-vertex.json).
# Stored as the secret flybot-<STAGE>-gcp. Empty: chatbot off.
GCP_SERVICE_ACCOUNT_FILE=

# Google Cloud project. Empty: the project_id of that JSON.
VERTEX_PROJECT_ID=

# Vertex AI location. Empty: global.
VERTEX_LOCATION=

# Gemini model. Empty: gemini-2.5-flash.
VERTEX_MODEL=


# ===================================================================== Payments (optional, PayOS / Stripe)
# Setup guide (accounts, keys, webhook URLs, test payments): FlyBot repository docs/payments.md (English) and
# docs/payments.vi.md (Vietnamese). Every key below is stored in Secrets Manager flybot-<STAGE>-app, never on the
# server's disk; emptying a key here removes it from the secret at the next ./deploy.sh. When PAYMENTS_ENABLED=true the
# summary prints the webhook URLs to enter at PayOS and Stripe.

# true turns online payment on. Default false. Not allowed with APP_MODE=b2b.
PAYMENTS_ENABLED=

# Days a plan paid online keeps working after its end date, before it falls back to FREE. Default 7.
PAYMENTS_GRACE_DAYS=

# true on the production server only: allows a live Stripe key (sk_live_ / rk_live_). Default false.
PAYMENTS_ALLOW_LIVE=

# (secret) PayOS payment channel: Client ID.
PAYOS_CLIENT_ID=

# (secret) PayOS payment channel: API Key.
PAYOS_API_KEY=

# (secret) PayOS payment channel: Checksum Key (signs requests, checks webhooks).
PAYOS_CHECKSUM_KEY=

# PayOS API address. Default https://api-merchant.payos.vn
PAYOS_API_URL=

# How long a PayOS payment link stays open, in minutes. Default 60.
PAYOS_LINK_TTL_MINUTES=

# (secret) Stripe secret or restricted key: rk_test_ / sk_test_ (live keys need PAYMENTS_ALLOW_LIVE=true).
STRIPE_SECRET_KEY=

# (secret) Signing secret (whsec_) of the Stripe webhook endpoint https://<DOMAIN_NAME>/api/payments/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Stripe API address. Default https://api.stripe.com
STRIPE_API_URL=

# Seconds a signed Stripe webhook is accepted. Default 300.
STRIPE_WEBHOOK_TOLERANCE=


# ===================================================================== Self-registered demo cameras (CONTRACTS 2a)

# Cameras one account may claim.
DEMO_MAX_CAMERAS_PER_USER=3

# Photos per day for each self-registered camera.
DEMO_MAX_SNAPSHOTS_PER_DAY=48

# Unclaimed self-registered cameras in total.
DEMO_MAX_UNCLAIMED=200


# ===================================================================== Advanced (leave empty)

# Server type. Empty: t4g.micro (1 GB, 2 vCPU). Changing it stops and starts the server (its IP and disk stay).
INSTANCE_TYPE=

# EC2 key pair for SSH (optional).
KEY_NAME=

# Server image. Empty: the newest Amazon Linux 2023 arm64 at the first deploy, then kept (a new AMI would replace the
# server and its disk).
AMI_ID=

# Node.js version on the server. Empty: the newest 22.x.
NODE_VERSION=

# Caddy version on the server. Empty: 2.10.2.
CADDY_VERSION=

# Public bucket for the model weights. Empty: sentinel-<account>-models-public (anonymous read under models/*).
MODELS_BUCKET=

# Optional IoT rule webhook instead of FlyBot's MQTT subscriber: https://<domain>/api/device/events
DEVICE_EVENTS_URL=

# (secret) Required with DEVICE_EVENTS_URL: letters and digits only, 32 or more characters.
DEVICE_EVENTS_SECRET=

# 1: skip the Lambda latency measurement at the end of the deploy.
SKIP_COLDSTART=
