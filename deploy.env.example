# FlyBot on AWS: every deploy setting in one file.
#   cp deploy.env.example deploy.env     (deploy.env is git-ignored; never commit it)
#   fill it once, then:  aws login --profile sentinel  &&  ./deploy.sh
#
# Format: KEY=VALUE, one per line. Values are literal (no $ expansion). Quote a value that contains "#" or spaces:
# SMTP_PASS="ab #cd". Empty = default / feature off. Secret values are never printed by the scripts.

# ===================================================================== AWS
STAGE=dev                          # stack flybot-<STAGE>; resources are named with it
AWS_PROFILE=sentinel               # profile of `aws login`
AWS_REGION=ap-southeast-2          # the account's SCP allows Sydney only; any other value is refused

# ===================================================================== Web address + notifications
DOMAIN_NAME=flybot.agrhub.com      # Caddy gets the TLS certificate for it; add the A record the script prints
ACME_EMAIL=                        # Let's Encrypt contact (certificate expiry notices). Empty = ALARM_EMAIL
ALARM_EMAIL=                       # CloudWatch alarm email. Empty = reuse a topic with a confirmed email
                                   # (sentinel-dev-alarms); a new address gets a confirmation email to click
OWNER_CIDR=                        # SSH source (x.x.x.x/32). Empty = this laptop's public IP (checkip.amazonaws.com).
                                   # SSH is optional: the scripts use SSM, no key pair needed

# ===================================================================== Vision Lambda
DETECTOR=yolo26                    # yolo26 (models/yolo26/fruitfly_yolo26n.onnx, uploaded by the script) | yolov7
                                   # yolo26 without the local files falls back to yolov7 with a warning
PLANNER_MODE=rule                  # detect mode planner: rule (deterministic, free) | llm (Anthropic per photo)
ANTHROPIC_SECRET_NAME=sentinel-dev-anthropic   # reused when it exists (deep mode / llm planner)
ANTHROPIC_API_KEY=                 # only when that secret does not exist: stored as flybot-<STAGE>-anthropic
ANTHROPIC_MODEL=claude-haiku-5-5

# ===================================================================== FlyBot app (Secrets Manager flybot-<STAGE>-app)
# Created/updated by the script only when something changed; FlyBot reads it at start-up with the instance role.
JWT_SECRET=                        # empty = generated once and kept (changing it logs everybody out)
APP_KEY=                           # EZVIZ Open Platform app key (EZVIZ cameras BE4089629 / BE4111159)
SECRET_KEY=                        # EZVIZ Open Platform app secret
EZVIZ_DOMAIN=                      # empty = https://ivnopen.ezvizlife.com
TELEGRAM_BOT_TOKEN=                # @BotFather token; empty = Telegram alerts off
TELEGRAM_BOT_USERNAME=             # bot username without @
SMTP_HOST=                         # empty = emails (verification, reset, alerts) are written to the container log
SMTP_PORT=                         # 587 (STARTTLS) or 465 with SMTP_SECURE=true
SMTP_SECURE=
SMTP_USER=                         # the login; also the sender when it is an email address
SMTP_PASS=
MAIL_FROM=                         # e.g. FlyBot <no-reply@agrhub.com>; empty = SMTP_USER
CONTACT_EMAIL=
VAPID_PUBLIC_KEY=                  # web push; both empty = a pair is generated once (openssl) and kept
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                     # empty = mailto:<ACME_EMAIL>

# ===================================================================== Chatbot (Gemini on Vertex AI)
GCP_SERVICE_ACCOUNT_FILE=          # path to the Google service-account JSON (kept outside git, e.g.
                                   # C:/Users/me/keys/flybot-vertex.json); stored as secret flybot-<STAGE>-gcp.
                                   # Empty = chatbot off
VERTEX_PROJECT_ID=                 # empty = the project_id of that JSON
VERTEX_LOCATION=                   # empty = global
VERTEX_MODEL=                      # empty = gemini-2.5-flash

# ===================================================================== Private FlyBot app (submodule flybot/)
# agrhub/flybot is private. Default: the script makes a read-only deploy key (secret flybot-<STAGE>-deploykey) and
# prints the public half to add at github.com/agrhub/flybot > Settings > Deploy keys; it waits until GitHub accepts it.
FLYBOT_REPO_TOKEN=                 # alternative: fine-grained PAT, repository agrhub/flybot, Contents read-only
                                   # (stored as flybot-<STAGE>-repotoken; the host never keeps it in .env)
FLYBOT_REPO=                       # agrhub/flybot
REPO_WAIT_MIN=                     # 30: how long the script waits for the deploy key (--skip-wait: not at all)

# ===================================================================== Self-registered demo cameras (CONTRACTS 2a)
DEMO_MAX_CAMERAS_PER_USER=3
DEMO_MAX_SNAPSHOTS_PER_DAY=48
DEMO_MAX_UNCLAIMED=200

# ===================================================================== Advanced (leave empty)
INSTANCE_TYPE=                     # t4g.small
KEY_NAME=                          # EC2 key pair for SSH (optional)
REPO_URL=                          # https://github.com/agrhub/flybot-aws.git (the EC2 clones it)
REPO_REF=                          # main: the EC2 runs what is pushed there, not your local files
AMI_ID=                            # pinned after the first deploy (a new AMI would replace the instance and its MongoDB)
MODELS_BUCKET=                     # sentinel-<account>-models-public (anonymous GET under models/*)
DNS_WAIT_MIN=                      # 30: how long the health step waits for the DNS record
DEVICE_EVENTS_URL=                 # optional IoT rule webhook https://<domain>/api/device/events (IOT_EVENTS=rule)
DEVICE_EVENTS_SECRET=              # required with it: letters and digits only, 32+ characters
SKIP_COLDSTART=                    # 1 = skip the cold-start measurement at the end
