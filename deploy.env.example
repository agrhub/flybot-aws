# FlyBot on AWS: every deploy setting in one file.
#   cp deploy.env.example deploy.env     (deploy.env is git-ignored; never commit it)
#   fill it once, then:  aws login --profile sentinel  &&  ./deploy.sh
#
# Format: KEY=VALUE, one per line. Values are literal (no $ expansion). Quote a value that contains "#" or spaces:
# SMTP_PASS="ab #cd". Empty = default / feature off. Secret values are never printed by the scripts; the ones marked
# (secret) go to Secrets Manager flybot-<STAGE>-app and never to the server's disk.

# ===================================================================== AWS
STAGE=dev                          # stack flybot-<STAGE>; resources are named with it
AWS_PROFILE=sentinel               # profile of `aws login`
AWS_REGION=ap-southeast-2          # the account's SCP allows Sydney only; any other value is refused

# ===================================================================== Web address + notifications
DOMAIN_NAME=flybot.agrhub.com      # Caddy gets the TLS certificate for it; add the A record the script prints
ACME_EMAIL=                        # Let's Encrypt contact (certificate expiry notices). Empty = ALARM_EMAIL
ALARM_EMAIL=                       # CloudWatch alarm email. Empty = reuse a topic with a confirmed email;
                                   # a new address gets a confirmation email to click
OWNER_CIDR=                        # SSH source (x.x.x.x/32). Empty = this laptop's public IP (checkip.amazonaws.com).
                                   # SSH is optional: the scripts use SSM, no key pair needed

# ===================================================================== FlyBot build (on this computer)
FLYBOT_SRC=../ezviz-manager        # your FlyBot checkout (relative to this repo, or absolute). The script runs
                                   # npm ci (when package-lock.json changed) + npm run build here, uploads the
                                   # release to S3 and the server downloads it: the server needs no GitHub access.
                                   # Uncommitted changes are refused unless ./deploy.sh --allow-dirty
VITE_GOOGLE_MAP_KEY=               # Google Maps browser key baked into the client (public by nature; restrict it)

# ===================================================================== Database
MONGO_URI=                         # (secret) empty = MongoDB 7 on the server (data on its disk, backed up with it).
                                   # Set = that database, no MongoDB on the server, e.g.
                                   # mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/flybot
                                   # MongoDB Atlas: allow the Elastic IP the summary prints in the Atlas IP access list.
                                   # Careful: if other FlyBot servers use the same database, this server's start-up
                                   # migrations (e.g. workspaces-v1) run on that data too.

# ===================================================================== Photo storage
S3_BUCKET_NAME=                    # empty = the stack creates and owns flybot-photos-<account>-<STAGE>.
                                   # An existing AWS bucket name = used as is (the server and the Lambda get access;
                                   # the stack creates no photo bucket and never deletes yours)
S3_REGION=                         # the bucket's region (empty = looked up for an AWS bucket, "auto" for others)
S3_ENDPOINT=                       # S3-compatible storage (MinIO, Cloudflare R2, ...): https URL of the service. Then
                                   # FlyBot gives the Lambda presigned URLs (the service must be reachable from AWS) and
                                   # the annotated evidence pictures go to a small stack bucket instead
S3_ACCESS_KEY=                     # (secret) access key for S3_ENDPOINT (empty with an AWS bucket: the server's role)
S3_SECRET_KEY=                     # (secret)

# ===================================================================== Vision Lambda
DETECTOR=yolo26                    # yolo26 (models/yolo26/fruitfly_yolo26n.onnx, uploaded by the script) | yolov7
                                   # yolo26 without the local files falls back to yolov7 with a warning
PLANNER_MODE=rule                  # detect mode planner: rule (deterministic, free) | llm (Anthropic per photo)
ANTHROPIC_SECRET_NAME=sentinel-dev-anthropic   # reused when it exists (deep mode / llm planner)
ANTHROPIC_API_KEY=                 # (secret) only when that secret does not exist: stored as flybot-<STAGE>-anthropic
ANTHROPIC_MODEL=claude-haiku-5-5

# ===================================================================== FlyBot app
JWT_SECRET=                        # (secret) empty = generated once and kept (changing it logs everybody out)
APP_KEY=                           # (secret) EZVIZ Open Platform app key (EZVIZ cameras)
SECRET_KEY=                        # (secret) EZVIZ Open Platform app secret
EZVIZ_DOMAIN=                      # empty = https://ivnopen.ezvizlife.com
TELEGRAM_BOT_TOKEN=                # (secret) @BotFather token; empty = Telegram alerts off
TELEGRAM_BOT_USERNAME=             # bot username without @
SMTP_HOST=                         # empty = emails (verification, reset, alerts) are written to the server log
SMTP_PORT=                         # 587 (STARTTLS) or 465 with SMTP_SECURE=true
SMTP_SECURE=
SMTP_USER=                         # the login; also the sender when it is an email address
SMTP_PASS=                         # (secret)
MAIL_FROM=                         # e.g. FlyBot <no-reply@agrhub.com>; empty = SMTP_USER
CONTACT_EMAIL=
VAPID_PUBLIC_KEY=                  # web push; both empty = a pair is generated once (openssl) and kept
VAPID_PRIVATE_KEY=                 # (secret)
VAPID_SUBJECT=                     # empty = mailto:<ACME_EMAIL>
APP_MODE=hybrid                    # b2c (personal workspaces) | b2b (organizations, invite-only) | hybrid (both)

# ===================================================================== Chatbot (Gemini on Vertex AI)
GCP_SERVICE_ACCOUNT_FILE=          # path to the Google service-account JSON (kept outside git, e.g.
                                   # C:/Users/me/keys/flybot-vertex.json); stored as secret flybot-<STAGE>-gcp.
                                   # Empty = chatbot off
VERTEX_PROJECT_ID=                 # empty = the project_id of that JSON
VERTEX_LOCATION=                   # empty = global
VERTEX_MODEL=                      # empty = gemini-2.5-flash

# ===================================================================== Self-registered demo cameras (CONTRACTS 2a)
DEMO_MAX_CAMERAS_PER_USER=3
DEMO_MAX_SNAPSHOTS_PER_DAY=48
DEMO_MAX_UNCLAIMED=200

# ===================================================================== Advanced (leave empty)
INSTANCE_TYPE=                     # t4g.micro (1 GB, 2 vCPU). Changing it stops/starts the server (IP and disk stay)
KEY_NAME=                          # EC2 key pair for SSH (optional)
AMI_ID=                            # pinned after the first deploy (a new AMI would replace the server and its disk)
NODE_VERSION=                      # Node.js on the server; empty = the newest 22.x
CADDY_VERSION=                     # 2.10.2
MODELS_BUCKET=                     # sentinel-<account>-models-public (anonymous GET under models/*)
DEVICE_EVENTS_URL=                 # optional IoT rule webhook https://<domain>/api/device/events (IOT_EVENTS=rule)
DEVICE_EVENTS_SECRET=              # required with it: letters and digits only, 32+ characters
SKIP_COLDSTART=                    # 1 = skip the cold-start measurement at the end
