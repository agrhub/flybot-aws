# FlyBot vision Lambda, local environment (copy to .env; .env is git-ignored).
# Load: make lambda-local ENV_FILE=.env   (or, from lambda/vision: uv run --env-file ../../.env python -m sentinel.lambda_local)

# --- detector (lambda/vision/sentinel/vision/detector.py) ---
DETECTOR=yolov7                      # yolov7 (baseline, `make models`) | yolo26 (models/COLAB_RUNBOOK.md)
# DETECTOR_ONNX=models/yolo26/fruitfly_yolo26n.onnx   # explicit ONNX path (wins over the defaults)
# YOLO26_URL=https://sentinel-685527430355-models-public.s3.ap-southeast-2.amazonaws.com/yolo26/fruitfly_yolo26n.onnx
# YOLO26_SHA256=

# --- planner / LLM (lambda/vision/sentinel/agent/wiring.py) ---
SENTINEL_PLANNER=rule                # rule | llm (detect mode; deep mode always tries the LLM when a key exists)
SENTINEL_LLM_BACKEND=anthropic       # anthropic | bedrock | fake
ANTHROPIC_API_KEY=                   # sk-ant-... (never commit, never paste in chat); on AWS: Secrets Manager sentinel-dev-anthropic
SENTINEL_ANTHROPIC_MODEL=claude-haiku-5-5
SENTINEL_WEATHER=off                 # off | open-meteo (the surge -> treatment rule needs weather + camera GPS)
SENTINEL_KILL_SWITCH=0               # 1 = analysis only, no proposals

# --- evidence ---
EVIDENCE_DIR=data/evidence           # local runs: annotated JPEGs under evidence/<cameraId>/
# PHOTOS_BUCKET=flybot-photos-685527430355-dev   # set by the stack on AWS; locally only after `aws login --profile sentinel`
SENTINEL_AWS_PROFILE=sentinel
SENTINEL_AWS_REGION=ap-southeast-2

# ======================= FlyBot on a laptop (docker-compose.yml: flybot + mongo + caddy) =======================
# Local development only. The AWS deployment is configured by deploy.env (./deploy.sh): the server's environment is
# written by the stack and its secrets come from Secrets Manager flybot-<stage>-app.
# Laptop: copy this file to .env, set VISION_LAMBDA_URL to the local Lambda and the AWS credentials of `aws login`.

# --- host ---
DOMAIN_NAME=flybot.agrhub.com        # Caddy's certificate name; "localhost" on a laptop (self-signed)
ACME_EMAIL=                          # Let's Encrypt contact (optional)
FLYBOT_HOST_PORT=8080                # FlyBot without Caddy: http://localhost:8080
FLYBOT_BIND=127.0.0.1                # host address of that port (0.0.0.0 to reach it from another machine)
COOKIE_SECURE=true                   # false when opening http://localhost:8080 directly
APP_BASE_URL=                        # default https://DOMAIN_NAME; http://localhost:8080 on a laptop
DEVICE_API_BASE_URL=                 # what the cameras call (default APP_BASE_URL)

# --- secrets (Secrets Manager, read by the instance role; or set them here on a laptop) ---
FLYBOT_SECRETS=                      # e.g. flybot-dev-app: a JSON secret {"JWT_SECRET": "...", "APP_KEY": "...", "SECRET_KEY": "...", "SMTP_PASS": "...", "TELEGRAM_BOT_TOKEN": "..."}
JWT_SECRET=                          # at least 32 characters (required unless in the secret)
APP_KEY=                             # EZVIZ Open Platform app key (EZVIZ cameras only)
SECRET_KEY=                          # EZVIZ Open Platform app secret
EZVIZ_DOMAIN=https://ivnopen.ezvizlife.com

# --- photos (the stack's S3 bucket; no keys on AWS) ---
PHOTOS_BUCKET=                       # written by the stack: flybot-photos-<account>-<stage>
S3_BUCKET_NAME=                      # default PHOTOS_BUCKET
S3_ENDPOINT=                         # empty = AWS S3; a MinIO URL on a laptop without AWS
S3_ACCESS_KEY=                       # MinIO only
S3_SECRET_KEY=                       # MinIO only
PHOTOS_BY_REFERENCE=true             # the Lambda reads bucket/key (false = signed URLs, e.g. MinIO)

# --- vision (CONTRACTS section 1) ---
AI_PROVIDER=opencv-lambda
APP_MODE=hybrid
VISION_LAMBDA_NAME=                  # written by the stack: flybot-vision-<stage>
VISION_LAMBDA_URL=                   # laptop: http://host.docker.internal:9001/invoke (uv run python -m sentinel.lambda_local)

# --- cameras: AWS IoT Core, Kinesis Video Streams ---
AWS_REGION=ap-southeast-2
IOT_ENDPOINT=a38gyfo6dhqxf4-ats.iot.ap-southeast-2.amazonaws.com   # aws iot describe-endpoint --endpoint-type iot:Data-ATS
IOT_EVENTS=mqtt                      # mqtt (FlyBot subscribes over WebSocket) | rule (IoT rule -> POST /api/device/events) | off
IOT_RULE_SECRET=                     # shared secret of that rule (X-IoT-Rule-Secret)
KVS_VIEWER_ROLE_ARN=                 # IAM role the browser assumes for live view (stack output KvsViewerRoleArn); empty = live view 503
DEVICE_OTA_FW=                       # firmware offered by GET /api/device/ota (all three set)
DEVICE_OTA_URL=
DEVICE_OTA_SHA256=

# --- chatbot (Gemini on Vertex AI) ---
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash
GOOGLE_APPLICATION_CREDENTIALS=      # /app/secrets/gcp-service-account.json when the key file is in ./secrets/

# --- laptop only: AWS credentials for the containers (`aws configure export-credentials --profile sentinel --format env`) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- optional, as in flybot/.env.example ---
ALLOW_REGISTRATION=true
ENABLE_CRON=true
SENTINEL_CAPTURE_BUDGET=4
SENTINEL_PROPOSAL_TTL_HOURS=24
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
VITE_GOOGLE_MAP_KEY=
